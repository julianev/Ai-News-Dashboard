# LLM backend for the digest (OpenAI-compatible). Default base URL is OpenRouter (see config/settings.json llmBaseUrl).
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional: if you point llmBaseUrl at a LiteLLM gateway (or other OpenAI-compatible endpoint), set its key here instead.
LITELLM_API_KEY=
YOUTUBE_API_KEY=your-youtube-api-key-here
GITHUB_TOKEN=
DISCORD_WEBHOOK_URL=your-discord-webhook-url-here
